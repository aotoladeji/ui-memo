# University Memo System - Environment Configuration
# Copy this file to .env and configure for your environment

# API Configuration
# For development with Laravel backend: VITE_API_BASE=/api/v1 (Vite will proxy to localhost:8000)
# For production: VITE_API_BASE=https://your-domain.edu.ng/api/v1
VITE_API_BASE=/api/v1

# Mock Mode (Demo/Presentation)
# Set to true for standalone demo without backend
# Set to false to connect to Laravel API
VITE_USE_MOCK=false
